# Copy this file to ".env" and fill in the real values from the exercise PDF.
# ".env" is gitignored - NEVER commit real credentials.

# --- Evinced SDK licensing (online mode) - read by global.setup.js ---
EVINCED_SERVICE_ID=your-service-id-here
EVINCED_API_KEY=your-api-key-here

# --- JFrog npm registry auth - used only by `npm install` ---
# npm reads this from the shell environment, not from .env, so export it first:
#   PowerShell : $env:JFROG_AUTH_TOKEN = "eyJ2ZXIi..."
#   bash/zsh   : export JFROG_AUTH_TOKEN="eyJ2ZXIi..."
JFROG_AUTH_TOKEN=your-jfrog-jwt-here
