# JFrog (Artifactory) registry for the private @evinced scope.
# The token is NOT stored here - npm substitutes it from the JFROG_AUTH_TOKEN
# environment variable at install time, so this file is safe to commit.
@evinced:registry=https://evinced.jfrog.io/artifactory/api/npm/restricted-npm/
//evinced.jfrog.io/artifactory/api/npm/restricted-npm/:_authToken=${JFROG_AUTH_TOKEN}
